# ============================================================
# toDus S3 Uploader Bot - Configuración
# ============================================================
# Telegram (obtener en https://my.telegram.org)
API_ID=20534584
API_HASH=6d5b13261d2c92a9a00afc1fd613b9df
BOT_TOKEN=8731241718:AAE2OAFlu5h4wvUdwsYxTkZ2SMR3M5P2bOo
BOT_SESSION_NAME=s3_bot_session

# ID del propietario del bot (puede cambiar /settings vía botones).
# Habla con @userinfobot para saber tu ID.
BOT_OWNER_ID=7363341763

# Usuarios autorizados a usar el bot (separados por coma).
# Vacío = bot público.
BOT_ALLOWED_USERS=

# Máximo por archivo (MB). Por defecto 800 MB (límite toDus).
MAX_FILE_MB=800

# ============================================================
# S3 de toDus (s3.todus.cu)
# ============================================================
# Credenciales de tu cuenta toDus para el almacenamiento S3.
# Normalmente NO hace falta tocar el endpoint ni el bucket.
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Directorios (dentros del contenedor Docker). No tocar salvo necesidad.
DOWNLOAD_DIR=/app/downloads
WORK_DIR=/app/data

# ============================================================
# Parámetros de subida por chunks (mutables vía /settings)
# ============================================================
# Tamaño de cada chunk S3 multipart (mínimo 5 MB).
S3_CHUNK_SIZE_MB=8

# Workers paralelos para subir chunks.
S3_MAX_PARALLEL=3

# Reintentos por chunk antes de declarar error crítico.
S3_MAX_RETRIES=10

# ============================================================
# Avanzado (opcional - no tocar salvo necesidad)
# ============================================================
# Expiración de URLs presignadas en segundos (default 7 días).
# S3_PRESIGN_EXPIRY=604800

# Si tienes un dominio CDN apuntando al bucket (URL pública estática):
# S3_PUBLIC_BASE_URL=
